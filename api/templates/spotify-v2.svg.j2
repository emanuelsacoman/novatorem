          fill="none" stroke="#fff" stroke-opacity=".28" stroke-width="1.2"/>

    <!-- Native SVG adaptive text: one line for compact titles, two for longer
         titles, progressively smaller type and a final ellipsis if necessary. -->
    <g id="metadata-text" clip-path="url(#metadata-clip)"
       font-family="Segoe UI, Arial, sans-serif">
      {% if title_lines|length == 1 %}
      <text data-role="track-title" x="204" y="92" font-size="{{ title_font_size }}"
            font-weight="700" letter-spacing="-.6"
            fill="#{{ title_color }}">{{ title_lines[0]|e }}</text>
      {% else %}
      <text data-role="track-title" x="204" y="78" font-size="{{ title_font_size }}"
            font-weight="700" letter-spacing="-.4"
            fill="#{{ title_color }}">{{ title_lines[0]|e }}</text>
      <text data-role="track-title" x="204" y="109" font-size="{{ title_font_size }}"
            font-weight="700" letter-spacing="-.4"
            fill="#{{ title_color }}">{{ title_lines[1]|e }}</text>
      {% endif %}
      <text data-role="track-artist" x="205" y="{{ artist_y }}" font-size="{{ artist_font_size }}"
            font-weight="400" fill="#{{ artist_color }}">{{ artist_display|e }}</text>
    </g>

