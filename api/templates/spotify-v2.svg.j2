        </ellipse>
      </g>
    </g>
    <!-- Colored glass, a light bloom and waveform trails behind all content. -->
    <g id="background-wave-trails">
      <animateTransform attributeName="transform" type="translate"
                        values="-12 2;28 -9;-20 10;-12 2"
                        dur="10.5s" repeatCount="indefinite"/>
    <path d="M-30 139 C90 80 145 33 240 63 S425 160 635 37" fill="none" stroke="url(#wave-stroke)"
          stroke-width="15" opacity=".30" filter="url(#soft-blur)">
      <animate attributeName="opacity" values=".16;.35;.22;.16" dur="13s" repeatCount="indefinite"/>
    </path>
    <path d="M-30 130 C90 71 150 28 245 57 S430 146 635 32" fill="none"
          stroke="url(#wave-stroke)" stroke-width="2" opacity=".55">
