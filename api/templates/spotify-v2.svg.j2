<svg xmlns="http://www.w3.org/2000/svg" width="520" height="160" viewBox="0 0 520 160" role="img" aria-labelledby="spotify-title spotify-desc">
  <title id="spotify-title">{{ label|e }} — {{ title|e }}</title>
  <desc id="spotify-desc">Spotify status: {{ label|e }}. {{ title|e }} by {{ artist|e }}.</desc>
  <defs>
    <linearGradient id="ambient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#{{ accent }}" stop-opacity=".22"/>
      <stop offset="85%" stop-color="#{{ background_color }}" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="cover-fallback" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#{{ accent }}" stop-opacity=".8"/>
      <stop offset="1" stop-color="#161b22"/>
    </linearGradient>
    <clipPath id="album-clip"><rect x="20" y="31" width="98" height="98" rx="12"/></clipPath>
  </defs>

  <rect x="0.5" y="0.5" width="519" height="159" rx="18" fill="#{{ background_color }}" stroke="#{{ border_color }}"/>
  <rect x="1" y="1" width="518" height="158" rx="17" fill="url(#ambient)"/>

  <rect x="20" y="31" width="98" height="98" rx="12" fill="url(#cover-fallback)"/>
  {% if album_image %}
  <image x="20" y="31" width="98" height="98" href="{{ album_image|e }}" preserveAspectRatio="xMidYMid slice" clip-path="url(#album-clip)"/>
  {% else %}
  <circle cx="69" cy="80" r="26" fill="#ffffff" fill-opacity=".15"/>
  <path d="M73 59v38a11 11 0 1 1-7-10V68l21-5v-9z" fill="#ffffff" fill-opacity=".85"/>
  {% endif %}

  <circle cx="151" cy="33" r="4" fill="{% if state == 'playing' %}#1ed760{% else %}#8b949e{% endif %}"/>
  <text x="162" y="37" fill="{% if state == 'playing' %}#1ed760{% else %}#adb6c0{% endif %}" font-family="Segoe UI, Arial, sans-serif" font-size="12" font-weight="700" letter-spacing="1.2">{{ label|e }}</text>

  <text x="145" y="77" fill="#f0f6fc" font-family="Segoe UI, Arial, sans-serif" font-size="22" font-weight="700">{{ title|e }}</text>
  <text x="145" y="104" fill="#b7c0cc" font-family="Segoe UI, Arial, sans-serif" font-size="16">{{ artist|e }}</text>

  <g transform="translate(465,23)" fill="#1ed760">
    <circle cx="12" cy="12" r="12"/>
    <path d="M5 8c5-2 11-1 15 1M6 12c5-1 10-.5 13 1M7 16c4-1 8-.2 11 1" fill="none" stroke="#0d1117" stroke-width="1.8" stroke-linecap="round"/>
  </g>

  <g transform="translate(146,122)" fill="{% if state == 'playing' %}#1ed760{% else %}#64748b{% endif %}">
    <rect x="0" y="7" width="3" height="8" rx="1.5"/>
    <rect x="7" y="2" width="3" height="13" rx="1.5"/>
    <rect x="14" y="5" width="3" height="10" rx="1.5"/>
    <rect x="21" y="0" width="3" height="15" rx="1.5"/>
    <rect x="28" y="4" width="3" height="11" rx="1.5"/>
    <rect x="35" y="8" width="3" height="7" rx="1.5"/>
  </g>
  <text x="196" y="136" fill="#8b949e" font-size="11" font-family="Segoe UI, Arial, sans-serif">Spotify API · Emanuel</text>
</svg>
