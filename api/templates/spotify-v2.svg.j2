          opacity=".35" filter="url(#cover-shadow)"/>
    <rect x="22" y="21" width="148" height="148" rx="17" fill="url(#cover-fallback)"/>
    {% if album_image %}
    <image x="23" y="22" width="146" height="146" href="{{ album_image|e }}"
           preserveAspectRatio="xMidYMid slice" clip-path="url(#cover-clip)"/>
    {% else %}
    <g opacity=".77" fill="#eafff5" transform="translate(72,74)">
      <circle cx="23" cy="23" r="35" fill="#fff" fill-opacity=".10"/>
      <path d="M25-11V38a13 13 0 1 1-8-12V0l28-7v-9z"/>
    </g>
    {% endif %}
