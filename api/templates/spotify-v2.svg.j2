<svg xmlns="http://www.w3.org/2000/svg" width="600" height="190" viewBox="0 0 600 190"
     role="img" aria-labelledby="music-title music-description">
  <title id="music-title">{{ title|e }} — {{ artist|e }}</title>
  <desc id="music-description">Spotify music card. {{ label|e }}. Decorative animated equalizer background; not actual audio levels.</desc>
  <defs>
    <clipPath id="card-clip"><rect x="1" y="1" width="598" height="188" rx="21"/></clipPath>
    <clipPath id="cover-clip"><rect x="23" y="22" width="146" height="146" rx="16"/></clipPath>
    <linearGradient id="base-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#{{ accent_3 }}" stop-opacity=".28"/>
      <stop offset="55%" stop-color="#{{ background_color }}"/>
      <stop offset="100%" stop-color="#{{ accent_4 }}" stop-opacity=".20"/>
    </linearGradient>
    <radialGradient id="ambient-album" cx=".13" cy=".2" r=".79">
      <stop offset="0%" stop-color="#{{ accent }}" stop-opacity=".48"/>
      <stop offset="47%" stop-color="#{{ accent }}" stop-opacity=".14"/>
      <stop offset="100%" stop-color="#{{ accent }}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="ambient-secondary" cx=".80" cy=".81" r=".67">
      <stop offset="0%" stop-color="#{{ accent_2 }}" stop-opacity=".32"/>
      <stop offset="58%" stop-color="#{{ accent_3 }}" stop-opacity=".12"/>
      <stop offset="100%" stop-color="#{{ accent_4 }}" stop-opacity="0"/>
    </radialGradient>
    <!-- Strong top-to-bottom album-color fade, with a luminous cap and soft floor. -->
    <linearGradient id="bars-gradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#{{ accent_4 }}" stop-opacity=".94"/>
      <stop offset="20%" stop-color="#{{ accent_2 }}" stop-opacity=".84"/>
      <stop offset="58%" stop-color="#{{ accent_3 }}" stop-opacity=".58"/>
      <stop offset="100%" stop-color="#{{ accent }}" stop-opacity=".10"/>
    </linearGradient>
    <linearGradient id="glass" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff" stop-opacity=".10"/>
      <stop offset="36%" stop-color="#fff" stop-opacity="0"/>
      <stop offset="100%" stop-color="#000" stop-opacity=".14"/>
    </linearGradient>
    <linearGradient id="text-shade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#071014" stop-opacity=".76"/>
      <stop offset="70%" stop-color="#071014" stop-opacity=".61"/>
      <stop offset="100%" stop-color="#071014" stop-opacity=".12"/>
    </linearGradient>
    <linearGradient id="wave-stroke" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#{{ accent }}" stop-opacity=".10"/>
      <stop offset="40%" stop-color="#{{ accent_2 }}" stop-opacity=".64"/>
      <stop offset="100%" stop-color="#{{ accent_3 }}" stop-opacity=".22"/>
    </linearGradient>
    <filter id="soft-blur" x="-30%" y="-80%" width="160%" height="260%">
      <feGaussianBlur stdDeviation="7"/>
    </filter>
    <filter id="cover-shadow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="10"/>
    </filter>
    <linearGradient id="cover-fallback" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#{{ accent }}"/>
      <stop offset="100%" stop-color="#0b171f"/>
    </linearGradient>
  </defs>

