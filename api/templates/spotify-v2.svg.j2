<svg xmlns="http://www.w3.org/2000/svg" width="520" height="160" viewBox="0 0 520 160" role="img" aria-labelledby="spotify-title spotify-desc">
  <title id="spotify-title">{{ label|e }} — {{ title|e }}</title>
  <desc id="spotify-desc">Spotify status: {{ label|e }}. {{ title|e }} by {{ artist|e }}.</desc>
  <defs>
    <linearGradient id="ambient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#{{ accent }}" stop-opacity=".22"/>
      <stop offset="85%" stop-color="#{{ background_color }}" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="cover-fallback" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#{{ accent }}" stop-opacity=".8"/>
      <stop offset="1" stop-color="#161b22"/>
    </linearGradient>
    <clipPath id="album-clip"><rect x="20" y="31" width="98" height="98" rx="12"/></clipPath>
  </defs>

  <rect x="0.5" y="0.5" width="519" height="159" rx="18" fill="#{{ background_color }}" stroke="#{{ border_color }}"/>
  <rect x="1" y="1" width="518" height="158" rx="17" fill="url(#ambient)"/>

  <rect x="20" y="31" width="98" height="98" rx="12" fill="url(#cover-fallback)"/>
  {% if album_image %}
  <image x="20" y="31" width="98" height="98" href="{{ album_image|e }}" preserveAspectRatio="xMidYMid slice" clip-path="url(#album-clip)"/>
  {% else %}
  <circle cx="69" cy="80" r="26" fill="#ffffff" fill-opacity=".15"/>
  <path d="M73 59v38a11 11 0 1 1-7-10V68l21-5v-9z" fill="#ffffff" fill-opacity=".85"/>
  {% endif %}

  <circle cx="151" cy="33" r="4" fill="{% if state == 'playing' %}#1ed760{% else %}#8b949e{% endif %}"/>
  <text x="162" y="37" fill="{% if state == 'playing' %}#1ed760{% else %}#adb6c0{% endif %}" font-family="Segoe UI, Arial, sans-serif" font-size="12" font-weight="700" letter-spacing="1.2">{{ label|e }}</text>

  <text x="145" y="77" fill="#f0f6fc" font-family="Segoe UI, Arial, sans-serif" font-size="22" font-weight="700">{{ title|e }}</text>
  <text x="145" y="104" fill="#b7c0cc" font-family="Segoe UI, Arial, sans-serif" font-size="16">{{ artist|e }}</text>

  <g transform="translate(465,23)" fill="#1ed760">
    <circle cx="12" cy="12" r="12"/>
    <path d="M5 8c5-2 11-1 15 1M6 12c5-1 10-.5 13 1M7 16c4-1 8-.2 11 1" fill="none" stroke="#0d1117" stroke-width="1.8" stroke-linecap="round"/>
  </g>

  <!-- Native SVG/SMIL animation: purely decorative, not real audio levels. -->
  <g transform="translate(146,122)" fill="{% if state == 'playing' %}#1ed760{% elif state == 'recent' %}#81ab94{% else %}#64748b{% endif %}">
    <rect x="0" y="11" width="3" height="4" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="4;13;7;11;4" dur="{% if state == 'playing' %}0.85s{% else %}2.00s{% endif %}" begin="-0.16s" repeatCount="indefinite"/>
      <animate attributeName="y" values="11;2;8;4;11" dur="{% if state == 'playing' %}0.85s{% else %}2.00s{% endif %}" begin="-0.16s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="7" y="5" width="3" height="10" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="10;5;15;8;10" dur="{% if state == 'playing' %}1.02s{% else %}2.24s{% endif %}" begin="-0.35s" repeatCount="indefinite"/>
      <animate attributeName="y" values="5;10;0;7;5" dur="{% if state == 'playing' %}1.02s{% else %}2.24s{% endif %}" begin="-0.35s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="14" y="9" width="3" height="6" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="6;12;4;14;6" dur="{% if state == 'playing' %}1.19s{% else %}2.48s{% endif %}" begin="-0.54s" repeatCount="indefinite"/>
      <animate attributeName="y" values="9;3;11;1;9" dur="{% if state == 'playing' %}1.19s{% else %}2.48s{% endif %}" begin="-0.54s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="21" y="2" width="3" height="13" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="13;7;10;3;13" dur="{% if state == 'playing' %}1.36s{% else %}2.72s{% endif %}" begin="-0.73s" repeatCount="indefinite"/>
      <animate attributeName="y" values="2;8;5;12;2" dur="{% if state == 'playing' %}1.36s{% else %}2.72s{% endif %}" begin="-0.73s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="28" y="7" width="3" height="8" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="8;15;5;11;8" dur="{% if state == 'playing' %}1.53s{% else %}2.96s{% endif %}" begin="-0.92s" repeatCount="indefinite"/>
      <animate attributeName="y" values="7;0;10;4;7" dur="{% if state == 'playing' %}1.53s{% else %}2.96s{% endif %}" begin="-0.92s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="35" y="10" width="3" height="5" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="5;10;14;7;5" dur="{% if state == 'playing' %}0.85s{% else %}2.00s{% endif %}" begin="-0.16s" repeatCount="indefinite"/>
      <animate attributeName="y" values="10;5;1;8;10" dur="{% if state == 'playing' %}0.85s{% else %}2.00s{% endif %}" begin="-0.16s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="42" y="3" width="3" height="12" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="12;4;9;15;12" dur="{% if state == 'playing' %}1.02s{% else %}2.24s{% endif %}" begin="-0.35s" repeatCount="indefinite"/>
      <animate attributeName="y" values="3;11;6;0;3" dur="{% if state == 'playing' %}1.02s{% else %}2.24s{% endif %}" begin="-0.35s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="49" y="8" width="3" height="7" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="7;14;6;10;7" dur="{% if state == 'playing' %}1.19s{% else %}2.48s{% endif %}" begin="-0.54s" repeatCount="indefinite"/>
      <animate attributeName="y" values="8;1;9;5;8" dur="{% if state == 'playing' %}1.19s{% else %}2.48s{% endif %}" begin="-0.54s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="56" y="1" width="3" height="14" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="14;9;4;12;14" dur="{% if state == 'playing' %}1.36s{% else %}2.72s{% endif %}" begin="-0.73s" repeatCount="indefinite"/>
      <animate attributeName="y" values="1;6;11;3;1" dur="{% if state == 'playing' %}1.36s{% else %}2.72s{% endif %}" begin="-0.73s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="63" y="10" width="3" height="5" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="5;11;15;8;5" dur="{% if state == 'playing' %}1.53s{% else %}2.96s{% endif %}" begin="-0.92s" repeatCount="indefinite"/>
      <animate attributeName="y" values="10;4;0;7;10" dur="{% if state == 'playing' %}1.53s{% else %}2.96s{% endif %}" begin="-0.92s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="70" y="4" width="3" height="11" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="11;6;13;3;11" dur="{% if state == 'playing' %}0.85s{% else %}2.00s{% endif %}" begin="-0.16s" repeatCount="indefinite"/>
      <animate attributeName="y" values="4;9;2;12;4" dur="{% if state == 'playing' %}0.85s{% else %}2.00s{% endif %}" begin="-0.16s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
    <rect x="77" y="8" width="3" height="7" rx="1.5">
      {% if state in ('playing', 'recent') %}
      <animate attributeName="height" values="7;14;10;5;7" dur="{% if state == 'playing' %}1.02s{% else %}2.24s{% endif %}" begin="-0.35s" repeatCount="indefinite"/>
      <animate attributeName="y" values="8;1;5;10;8" dur="{% if state == 'playing' %}1.02s{% else %}2.24s{% endif %}" begin="-0.35s" repeatCount="indefinite"/>
      {% endif %}
    </rect>
  </g>
  <text x="247" y="136" fill="#8b949e" font-size="11" font-family="Segoe UI, Arial, sans-serif">Spotify API · Emanuel</text>
</svg>
