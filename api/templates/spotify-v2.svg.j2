      <animate attributeName="opacity" values=".65;.95;.76;.65" dur="9.5s" repeatCount="indefinite"/>
    </rect>
    <rect width="600" height="190" fill="url(#ambient-secondary)" opacity=".78">
      <animate attributeName="opacity" values=".85;.49;.91;.85" dur="11s" repeatCount="indefinite"/>
    </rect>
    <!-- Animated background effects: glow pools and ribbon trails stay behind
         the independent bars, the dark text veil, the cover and all labels. -->
    <g id="background-effects">
      <g id="ambient-glow-orbs">
        <ellipse id="glow-orb-primary" cx="125" cy="55" rx="215" ry="143"
                 fill="url(#glow-orb-primary)" opacity=".54">
