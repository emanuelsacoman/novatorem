          <animate attributeName="cy" values="55;88;142;80;55" dur="11s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values=".46;.72;.54;.62;.46" dur="8s" repeatCount="indefinite"/>
        </ellipse>
        <ellipse id="glow-orb-secondary" cx="490" cy="145" rx="205" ry="128"
